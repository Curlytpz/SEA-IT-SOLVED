# SEA-IT-SOLVED source stays tracked; only secrets, generated output, and local tooling are excluded.

# Environment files and credentials
**/.env
**/.env.*
!**/.env.example
*.pem
*.key
*.p12
*.pfx
*.jks

# Dependencies and generated application output
**/node_modules/
**/dist/
**/build/
**/coverage/
**/.vite/
**/.cache/
**/tmp/
**/temp/
*.tmp
*.temp

# Runtime data and user uploads
backend/storage/
backend/uploads/
backend/.demo-qa/
*.sqlite
*.sqlite3
*.db
*.dump
*.backup

# Logs and process artifacts
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.pid
*.pid.lock

# Local Codex, QA, and browser-session artifacts
/.agents/
/.codex/
/.codex-runtime/
/.impeccable/
/.qa/
**/playwright-report/
**/test-results/
**/.nyc_output/

# Python environments and generated caches
**/__pycache__/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.venv/
**/venv/
*.py[cod]

# Editor and operating-system files
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~

# Backup and merge artifacts
*.bak
*.orig
