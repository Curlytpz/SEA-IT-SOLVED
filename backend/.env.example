PORT=4000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_NAME=sea_it_solved
DB_USER=postgres
DB_PASSWORD=

JWT_SECRET=
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_TTL_MINUTES=30

# Password-reset email. Development prints the reset URL in the backend terminal.
# A production provider can replace this transport later without changing auth logic.
MAIL_PROVIDER=development
RESEND_API_KEY=
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=
MAIL_FROM=
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_SENDER_EMAIL=

STUDENT_EMAIL_DOMAIN=student.hau.edu.ph
INSTRUCTOR_EMAIL_DOMAIN=hau.edu.ph

CAPTURE_STORAGE_PATH=
AUDIO_STORAGE_PATH=
AUDIO_MAX_UPLOAD_MB=128
LESSON_MATERIAL_STORAGE_PATH=
LESSON_MATERIAL_IMAGE_MAX_MB=12
LESSON_MATERIAL_PDF_MAX_MB=32
LESSON_MATERIAL_PDF_MAX_PAGES=50

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_REASONING_MODEL=gemini-3.6-flash
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_QUIZ_MODEL=gemini-2.5-flash
GEMINI_QUIZ_TIMEOUT_MS=120000
GEMINI_INTERACTIVE_TIMEOUT_MS=120000
GEMINI_MEDIA_RESOLUTION=HIGH
GEMINI_SHARED_MIN_REQUEST_INTERVAL_MS=30000
GEMINI_SHARED_RATE_LIMIT_BACKOFF_MS=120000

RECOGNITION_MAX_ATTEMPTS=3
RECOGNITION_PROVIDER_TIMEOUT_MS=90000
RECOGNITION_JOB_TIMEOUT_MS=120000
TRANSCRIPTION_MAX_ATTEMPTS=3
TRANSCRIPTION_PROVIDER_TIMEOUT_MS=600000
# Optional executable path. Leave blank to resolve ffmpeg through the server PATH.
# Paths containing spaces are supported; do not include command-line arguments.
FFMPEG_PATH=

# Descriptive assessment threshold used by Concept Progression (1-100).
ANALYTICS_PERFORMANCE_THRESHOLD_PERCENT=80
