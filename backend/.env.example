PORT=4000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_NAME=sea_it_solved
DB_USER=postgres
DB_PASSWORD=
# Use certificate-verified TLS for hosted PostgreSQL. Required for Supabase production.
DB_SSL=false
# Optional custom CA, resolved relative to the backend directory when not absolute.
DB_SSL_CA_PATH=

JWT_SECRET=
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173
TRUST_PROXY_HOPS=1
PASSWORD_RESET_TTL_MINUTES=30
EMAIL_VERIFICATION_TTL_MINUTES=60
API_RATE_LIMIT_MAX=1200
AUTH_RATE_LIMIT_MAX=20

# Password-reset email. Development prints password-reset URLs only.
# Student verification never logs raw tokens; configure a real provider to test that flow.
MAIL_PROVIDER=development
RESEND_API_KEY=
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=
MAIL_FROM=
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_SENDER_EMAIL=

STUDENT_EMAIL_DOMAIN=student.hau.edu.ph
INSTRUCTOR_EMAIL_DOMAIN=hau.edu.ph

CAPTURE_STORAGE_PATH=
CAPTURE_MAX_AGGREGATE_MB=48
CAPTURE_MAX_CONCURRENT_UPLOADS=2
CAPTURE_MAX_CONCURRENT_PER_USER=1
AUDIO_STORAGE_PATH=
AUDIO_MAX_UPLOAD_MB=128
LESSON_MATERIAL_STORAGE_PATH=
LESSON_MATERIAL_IMAGE_MAX_MB=12
LESSON_MATERIAL_PDF_MAX_MB=32
LESSON_MATERIAL_PDF_MAX_PAGES=50

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_RECOGNITION_MODEL=gemini-2.5-flash
GEMINI_TRANSCRIPTION_MODEL=gemini-2.5-flash
GEMINI_REASONING_MODEL=gemini-2.5-flash
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_QUIZ_MODEL=gemini-2.5-flash
GEMINI_QUIZ_TIMEOUT_MS=120000
GEMINI_INTERACTIVE_TIMEOUT_MS=120000
QUIZ_TUTOR_MAX_PRACTICE_PER_ATTEMPT=3
QUIZ_TUTOR_PROCESSING_STALE_MS=300000
GEMINI_MEDIA_RESOLUTION=HIGH
GEMINI_SHARED_MIN_REQUEST_INTERVAL_MS=30000
GEMINI_SHARED_RATE_LIMIT_BACKOFF_MS=120000
AI_MAX_CONCURRENT_REQUESTS=2
AI_MAX_PENDING_REQUESTS=10
AI_MAX_PENDING_PER_USER=3
AI_QUEUE_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
AI_RETRY_BASE_DELAY_MS=1000

RECOGNITION_MAX_ATTEMPTS=3
RECOGNITION_POLL_INTERVAL_MS=3000
RECOGNITION_PROVIDER_TIMEOUT_MS=90000
RECOGNITION_JOB_TIMEOUT_MS=120000
RECOGNITION_MAX_CAPTURES=100
RECOGNITION_MAX_AGGREGATE_MB=256
TRANSCRIPTION_MAX_ATTEMPTS=3
TRANSCRIPTION_POLL_INTERVAL_MS=3000
TRANSCRIPTION_PROVIDER_TIMEOUT_MS=600000
TRANSCRIPTION_JOB_TIMEOUT_MS=1000000
# Optional executable path. Leave blank to resolve ffmpeg through the server PATH.
# Paths containing spaces are supported; do not include command-line arguments.
FFMPEG_PATH=
FFPROBE_PATH=
TRANSCRIPTION_FFMPEG_TIMEOUT_MS=240000
TRANSCRIPTION_MAX_OUTPUT_MB=256

# Descriptive assessment threshold used by Concept Progression (1-100).
ANALYTICS_PERFORMANCE_THRESHOLD_PERCENT=80
